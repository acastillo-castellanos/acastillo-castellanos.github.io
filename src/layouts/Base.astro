---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;

const navLinks = [
  { href: withBase('/'), label: 'About' },
  { href: withBase('/projects/'), label: 'Projects' },
  { href: withBase('/publications/'), label: 'Publications' },
  { href: withBase('/blog/'), label: 'Blog' },
  { href: withBase('/cv/'), label: 'CV' },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === withBase('/') ? pathname === href : pathname.startsWith(href);

const year = new Date().getFullYear();

// Dual-deployment canonical origin: always attributes canonical authority to the primary site
const canonicalOrigin = 'https://acastillo-castellanos.github.io';
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '');
const relativePath = pathname.startsWith(basePath)
  ? pathname.slice(basePath.length)
  : pathname;
const cleanPath = relativePath.startsWith('/') ? relativePath : `/${relativePath}`;
const canonicalURL = new URL(cleanPath, canonicalOrigin).href;
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image.replace(/^\/+/, ''), `${canonicalOrigin}/`).href)
  : new URL('media/hero-full.webp', `${canonicalOrigin}/`).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'"
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={withBase('/rss.xml')}
    />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="bg-accent absolute left-2 -top-16 z-10 rounded px-3 py-2 text-white focus:top-2"
      >Skip to content</a
    >
    <header class="border-rule border-b px-4">
      <nav
        class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-4 gap-y-2 py-4 text-sm"
      >
        <a href={withBase('/')} class="text-ink font-semibold no-underline">{SITE.author}</a>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'py-1 no-underline',
                  isActive(link.href)
                    ? 'text-accent underline underline-offset-4'
                    : 'text-ink-muted',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>
    <main id="content" class="mx-auto w-full max-w-2xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-rule border-t px-4">
      <p class="text-ink-muted mx-auto max-w-2xl py-6 text-sm">
        © {year} {SITE.author} · <a href={withBase('/rss.xml')}>RSS</a>
      </p>
    </footer>
  </body>
</html>
