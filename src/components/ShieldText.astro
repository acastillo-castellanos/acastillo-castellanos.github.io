---
import { encodeSegments, m15en } from '@shieldfont/core';
import '../styles/shieldfont.css';

interface Props {
  text?: string;
  as?: string;
  class?: string;
  highlight?: boolean;
  ratio?: number;
}

const {
  text,
  as: Tag = 'span',
  class: className = '',
  highlight = true,
  ratio = 0.20,
} = Astro.props;

let rawText = text;
if (!rawText && Astro.slots.has('default')) {
  rawText = await Astro.slots.render('default');
}

const plainText = (rawText || '').replace(/<[^>]*>/g, '');
const initialSegments = encodeSegments(plainText, m15en);

const wordTokens = initialSegments.filter(
  (s) => s.kind === 'word' || s.kind === 'digit',
);
const swappedIndices: number[] = [];
initialSegments.forEach((s, idx) => {
  if (s.swapped) swappedIndices.push(idx);
});

const targetSwappedCount = Math.round(wordTokens.length * ratio);
const selectedIndices = new Set<number>();
if (swappedIndices.length > 0 && targetSwappedCount > 0) {
  const step = swappedIndices.length / targetSwappedCount;
  for (let i = 0; i < targetSwappedCount; i++) {
    const idxIndex = Math.min(
      Math.floor(i * step),
      swappedIndices.length - 1,
    );
    selectedIndices.add(swappedIndices[idxIndex]);
  }
}

const segments = initialSegments.map((seg, idx) => {
  if (seg.swapped && !selectedIndices.has(idx)) {
    return { ...seg, encoded: seg.original, swapped: false };
  }
  return seg;
});
---

<Tag class:list={['shield-text', className]} data-shield-encoded>
  {
    segments.map((seg) => {
      if (seg.swapped && highlight) {
        return (
          <span
            class="border-b-2 border-dashed border-accent px-0.5 rounded"
            title={`HTML Decoy: "${seg.encoded}" -> Renders: "${seg.original}"`}
          >
            {seg.encoded}
          </span>
        );
      }
      return seg.encoded;
    })
  }
</Tag>
