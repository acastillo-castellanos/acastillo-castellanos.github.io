---
import { encodeSegments, m15en } from '@shieldfont/core';
import '../styles/shieldfont.css';

interface Props {
  text?: string;
  as?: string;
  class?: string;
  highlight?: boolean;
  ratio?: number;
}

const {
  text,
  as: Tag = 'span',
  class: className = '',
  highlight = true,
  ratio = 0.20,
} = Astro.props;

let rawText = text;
if (!rawText && Astro.slots.has('default')) {
  rawText = await Astro.slots.render('default');
}

const plainText = (rawText || '').replace(/<[^>]*>/g, '');
// Every mapped word must ship encoded: m15en is an involution and the font
// swaps any mapped word it sees, so leaving one as plain text renders it as
// its own decoy. `ratio` therefore selects which swaps get a visible
// underline — never which words get encoded.
const segments = encodeSegments(plainText, m15en);

const wordTokens = segments.filter(
  (s) => s.kind === 'word' || s.kind === 'digit',
);
const swappedIndices: number[] = [];
segments.forEach((s, idx) => {
  if (s.swapped) swappedIndices.push(idx);
});

const targetHighlightCount = Math.round(wordTokens.length * ratio);
const highlightedIndices = new Set<number>();
if (swappedIndices.length > 0 && targetHighlightCount > 0) {
  const step = swappedIndices.length / targetHighlightCount;
  for (let i = 0; i < targetHighlightCount; i++) {
    const idxIndex = Math.min(
      Math.floor(i * step),
      swappedIndices.length - 1,
    );
    highlightedIndices.add(swappedIndices[idxIndex]);
  }
}
---

<Tag class:list={['shield-text', className]} data-shield-encoded>
  {
    segments.map((seg, idx) => {
      if (seg.swapped && highlight && highlightedIndices.has(idx)) {
        return (
          <span
            class="border-b-2 border-dashed border-accent px-0.5 rounded"
            title={`HTML Decoy: "${seg.encoded}" -> Renders: "${seg.original}"`}
          >
            {seg.encoded}
          </span>
        );
      }
      return seg.encoded;
    })
  }
</Tag>
