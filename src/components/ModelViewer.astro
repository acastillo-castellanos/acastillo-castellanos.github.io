---
// Embeds a .glb/.gltf model via Google's <model-viewer> web component.
// Self-hosted (bundled) rather than loaded from Google's CDN, so visitors'
// IPs are never sent to Google — same reasoning as self-hosted fonts.
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<script>
  import '@google/model-viewer';
</script>

<model-viewer
  src={src}
  alt={alt}
  camera-controls
  auto-rotate
  style="width: 100%; height: 400px;"
></model-viewer>
