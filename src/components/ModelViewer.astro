---
// Embeds a .glb/.gltf model via Google's <model-viewer> web component.
// The library is loaded only on pages that use this component.
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<script
  type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"
></script>

<model-viewer
  src={src}
  alt={alt}
  camera-controls
  auto-rotate
  style="width: 100%; height: 400px;"
></model-viewer>
