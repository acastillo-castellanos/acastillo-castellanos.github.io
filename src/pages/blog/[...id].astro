---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1 class="animate-in text-3xl font-semibold tracking-tight">{post.data.title}</h1>
    <p class="text-ink-muted mt-1 text-sm">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toISOString().slice(0, 10)}
      </time>
      {post.data.tags.length > 0 &&
        post.data.tags.map((tag) => <span> #{tag}</span>)}
    </p>
    <div class="prose prose-custom mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Base>
