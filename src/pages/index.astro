---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const icons = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.238 1.838 1.238 1.07 1.834 2.809 1.304 3.495.997.107-.775.418-1.305.762-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .321.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  orcid:
    'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.525.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z',
  scholar:
    'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.24 14.978 9.5 12 9.5c-2.977 0-5.548 1.74-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z',
  mail: 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
};

const links = [
  { href: SITE.links.github, label: 'GitHub', icon: icons.github },
  { href: SITE.links.orcid, label: 'ORCID', icon: icons.orcid },
  { href: SITE.links.scholar, label: 'Google Scholar', icon: icons.scholar },
];
---

<Base>
  <div class="flex items-center gap-6">
    {
      portrait && (
        <Image
          src={portrait}
          alt={SITE.author}
          width={112}
          height={112}
          class="h-28 w-28 shrink-0 rounded-full object-cover"
        />
      )
    }
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">{SITE.title}</h1>
      <p class="text-ink-muted mt-1">Research Engineer | PhD in Fluid Mechanics</p>
    </div>
  </div>
  <p class="mt-6 max-w-prose">
    Mechanical Engineer with a doctorate in fluid dynamics and over seven years
    of research experience. Specializing in modelling and simulation of heat
    transfer, vortex, and two-phase flow. Proficient in numerical methods, data
    analysis, visualization, scientific computing &amp; HPC.
  </p>
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 pl-0">
    {
      links.map((link) => (
        <li class="list-none">
          <a href={link.href} class="text-ink-muted hover:text-accent flex items-center gap-2 no-underline">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d={link.icon} />
            </svg>
            {link.label}
          </a>
        </li>
      ))
    }
    <li class="list-none">
      <a
        href={`mailto:${SITE.email}`}
        class="text-ink-muted hover:text-accent flex items-center gap-2 no-underline"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d={icons.mail} />
        </svg>
        {SITE.email}
      </a>
    </li>
  </ul>
</Base>
