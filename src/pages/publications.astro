---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const AUTHOR_NAME = 'A. Castillo-Castellanos';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year,
);

const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  const group = byYear.get(pub.data.year) ?? [];
  group.push(pub);
  byYear.set(pub.data.year, group);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Publications">
  <h1 class="text-3xl font-semibold tracking-tight">Publications</h1>
  {
    years.map((year) => (
      <section class="mt-10">
        <h2 class="text-ink text-lg font-semibold tracking-tight">{year}</h2>
        <ul class="mt-3 space-y-4 pl-0">
          {byYear.get(year)!.map(({ data }) => (
            <li class="list-none pl-6 -indent-6">
              {data.authors.map((author, i) => (
                <>
                  {i > 0 && ', '}
                  {author === AUTHOR_NAME ? <strong>{author}</strong> : author}
                </>
              ))}
              {' '}({data.year}). {data.title}.{' '}
              <em>{data.journal}</em>.
              {data.doi && (
                <>
                  {' '}
                  <a
                    href={`https://doi.org/${data.doi}`}
                    class="text-accent text-sm"
                  >
                    DOI
                  </a>
                </>
              )}
              {data.pdf && (
                <>
                  {' '}
                  <a href={data.pdf} class="text-accent text-sm">
                    PDF
                  </a>
                </>
              )}
              {data.hal && (
                <>
                  {' '}
                  <a href={data.hal} class="text-accent text-sm">
                    HAL
                  </a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
