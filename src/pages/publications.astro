---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PublicationYear from '../components/PublicationYear.astro';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year,
);

const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  const group = byYear.get(pub.data.year) ?? [];
  group.push(pub);
  byYear.set(pub.data.year, group);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

// The most recent years stay visible; older ones collapse behind a
// native <details> disclosure (works without JS).
const visibleYears = 4;
const recentYears = years.slice(0, visibleYears);
const earlierYears = years.slice(visibleYears);
const earlierCount = earlierYears.reduce((n, year) => n + byYear.get(year)!.length, 0);
---

<Base title="Publications">
  <h1 class="animate-in text-3xl font-semibold tracking-tight">Publications</h1>
  {recentYears.map((year) => <PublicationYear year={year} pubs={byYear.get(year)!} />)}

  {
    earlierYears.length > 0 && (
      <details class="group mt-10">
        <summary class="text-accent cursor-pointer list-none text-sm select-none">
          <span class="group-open:hidden">Show earlier publications ({earlierCount})</span>
          <span class="hidden group-open:inline">Hide earlier publications</span>
        </summary>
        {earlierYears.map((year) => (
          <PublicationYear year={year} pubs={byYear.get(year)!} />
        ))}
      </details>
    )
  }
</Base>
