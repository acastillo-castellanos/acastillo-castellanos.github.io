---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { withBase } from '../utils/url';

const downloadIcon =
  'M12 3v10.59l3.3-3.3 1.4 1.42L12 17.4l-4.7-4.7 1.4-1.41 3.3 3.3V3h2zM5 19h14v2H5v-2z';

const experience = [
  {
    role: 'Research Scientist, Centre Borelli',
    place: 'CNRS/École Normale Supérieure Paris-Saclay (UMR 9010), Gif-sur-Yvette, France. Work carried out within LRC MESO, a joint laboratory with CEA.',
    period: '2022–Present',
    bullets: [
      'Currently studying how surface tension and viscosity contrast alter the growth and mixing of the Rayleigh–Taylor instability, with results feeding machine-learning models at CEA.',
      'Studied how two immiscible fluids reach equilibrium under intense horizontal vibration ("frozen waves"). Currently, a micro-gravity campaign is planned with LPENS/CNES.',
      'Showed how Faraday surface waves mix the stratified fluid beneath them, building simple models from joint experiments and simulations.',
    ],
  },
  {
    role: 'Research Scientist, Institut de Recherche sur les Phénomènes Hors Équilibre (IRPHÉ)',
    place: 'CNRS/Aix-Marseille Université (UMR 7342), Marseille, France',
    period: '2019–2022',
    bullets: [
      'Modelled how the wake behind an asymmetric rotor breaks down, showing that vortex instabilities can be deliberately triggered to accelerate wake recovery.',
      'Showed how closely spaced pairs of helical vortices deform and become unstable (long-wave instabilities).',
    ],
  },
  {
    role: "Research Scientist, Laboratoire d'informatique pour la mécanique et les sciences de l'ingénieur (LIMSI, now LISN)",
    place: 'CNRS (UPR 3251), Orsay, France',
    period: '2017–2018',
    bullets: [
      'Built reduced-order models that capture the essential dynamics of flow reversals in turbulent convection (POD, CROM).',
    ],
  },
  {
    role: "PhD Student, Institut Jean Le Rond d'Alembert (IJLRDA)",
    place: 'CNRS/Sorbonne Université (UMR 7190), Paris, France',
    period: '2013–2017',
    bullets: [
      'Characterised rare, sudden changes of the large-scale circulation (flow reversals) in turbulent convection, from direct numerical simulations (DNS).',
      'Showed how lateral confinement and boundary conditions change the flow structure and heat transfer in turbulent convection.',
    ],
  },
];

const education = [
  {
    degree: 'PhD in Fluid Mechanics',
    place: 'Université Pierre-et-Marie-Curie (now Sorbonne Université), Paris, France',
    period: '2017'
  },
  {
    degree: 'MSc in Energetics & Environment',
    place: 'Arts et Métiers (ENSAM), Paris, France',
    period: '2013'
  },
  {
    degree: 'BSc in Mechanical Engineering (Ingeniero Mecánico)',
    place: 'Universidad Industrial de Santander, Bucaramanga, Colombia',
    period: '2008'
  },
];
---

<Base title="CV">
  <h1 class="animate-in text-3xl font-semibold tracking-tight">Curriculum Vitae</h1>
  <p class="text-ink-muted mt-3">
    Andrés Castillo-Castellanos · Research Scientist in Fluid Mechanics<br />
    {SITE.email} · {SITE.location}
  </p>

  <p class="mt-4 print:hidden">
    <a
      href={withBase('/cv_castillo_2026.pdf')}
      class="text-ink-muted hover:text-accent inline-flex items-center gap-2 no-underline"
      download
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d={downloadIcon} />
      </svg>
      Download CV (PDF)
    </a>
  </p>

  <h2 class="border-rule text-ink mt-10 border-b pb-1 text-lg font-semibold tracking-tight">
    Profile
  </h2>
  <p class="mt-3 max-w-prose">
    Research scientist in fluid mechanics with 12+ years of experience studying
    waves, hydrodynamic instabilities, and turbulence. I combine
    high-performance simulations, laboratory experiments, and simple models to
    understand how flows mix, destabilise, and organise — working closely with
    experimentalists and national-lab partners (CNRS, CEA, CNES).
  </p>

  <h2 class="border-rule text-ink mt-10 border-b pb-1 text-lg font-semibold tracking-tight">
    Research Experience
  </h2>
  <div class="mt-3 space-y-6">
    {
      experience.map((entry) => (
        <div class="grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-[8rem_1fr]">
          <p class="text-ink-muted text-sm sm:pt-0.5">{entry.period}</p>
          <div>
            <h3 class="text-ink font-medium">{entry.role}</h3>
            <p class="text-ink-muted text-sm">{entry.place}</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>

  <h2 class="border-rule text-ink mt-10 border-b pb-1 text-lg font-semibold tracking-tight">
    Education
  </h2>
  <div class="mt-3 space-y-3">
    {
      education.map((entry) => (
        <div class="grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-[8rem_1fr]">
          <p class="text-ink-muted text-sm sm:pt-0.5">{entry.period}</p>
          <div>
            <h3 class="text-ink font-medium">{entry.degree}</h3>
            <p class="text-ink-muted text-sm">{entry.place}</p>
          </div>
        </div>
      ))
    }
  </div>
</Base>

<style>
  @media print {
    :global(:root) {
      color-scheme: light;
    }
    :global(header),
    :global(footer) {
      display: none;
    }
    :global(body) {
      background: white;
      color: black;
    }
    :global(main) {
      max-width: none;
      padding: 0;
      margin: 0;
    }
    :global(.text-ink-muted) {
      color: #444;
    }
    :global(.border-rule) {
      border-color: #ccc;
    }
    :global(a) {
      color: black;
      text-decoration: none;
    }
  }
</style>
